//@version=6
// 백테스트용 strategy 버전 (BINANCE:BTCUSDT.P 5분봉 기준)
// 후보 A v2: 변동성 수축 후 돌파 + 가짜 돌파 필터
//   1) 레짐 필터 : 15분봉 EMA 방향 (롱은 위, 숏은 아래) + 직전 박스가 평소보다 좁았을 것(수축)
//   2) 트리거    : 확정봉 종가가 직전 N봉 박스 고점/저점을 뚫으면 진입
//   3) 확인 필터 : 돌파봉 거래량이 평균보다 클 것 / 돌파봉 종가가 봉 범위의 위쪽(롱)·아래쪽(숏)에 있을 것
//   4) 청산      : 손절 % / 익절 % / 최대 보유 봉 수
// - 모든 필터는 입력값으로 켜고 끌 수 있음 → tv-api 에서 --set 으로 조합 테스트
// - 신호 로직은 my_indicator.pine 과 항상 동일하게 유지할 것
strategy("My Scalping Strategy", shorttitle = "MySS", overlay = true,
     initial_capital       = 10000,
     default_qty_type      = strategy.percent_of_equity,
     default_qty_value     = 100,
     commission_type       = strategy.commission.percent,
     commission_value      = 0.04,            // 바이낸스 선물 테이커 수수료
     slippage              = 2,               // 틱 단위
     margin_long           = 0,               // v6 기본값 100 이면 자본 100% 진입 시 손실마다 마진콜 발생
     margin_short          = 0,
     calc_on_every_tick    = false,           // 리페인팅 방지: 봉 확정 시에만 계산
     process_orders_on_close = true)          // 확정봉 종가에 주문 처리

// ── 입력값 ──────────────────────────────────────────
grpBox  = "박스 / 수축"
boxLen  = input.int(12,  "박스 봉 수 (돌파 기준 고저)", minval = 3,  group = grpBox)
avgLen  = input.int(100, "평균 박스폭 산출 봉 수",     minval = 20, group = grpBox)
sqRatio = input.float(0.7, "수축 기준 (박스폭 / 평균박스폭 미만)", minval = 0.1, step = 0.05, group = grpBox)

grpFlt  = "레짐 필터"
useHtf  = input.bool(true, "상위 타임프레임 추세 필터 사용", group = grpFlt)
htfTf   = input.timeframe("15", "추세 필터 타임프레임", group = grpFlt)
htfLen  = input.int(21, "추세 EMA 기간", minval = 1, group = grpFlt)

grpCfm  = "돌파 확인 필터"
useVol  = input.bool(true, "거래량 확인 사용", group = grpCfm)
volLen  = input.int(20, "거래량 평균 봉 수", minval = 5, group = grpCfm)
volMult = input.float(1.5, "거래량 배수 (평균 대비)", minval = 0.5, step = 0.1, group = grpCfm)
useCls  = input.bool(true, "강한 종가 확인 사용", group = grpCfm)
clsPos  = input.float(0.7, "종가 위치 (봉 범위 내 0~1)", minval = 0.5, maxval = 1, step = 0.05, group = grpCfm)

grpExit = "청산"
slPct   = input.float(0.4, "손절 %", minval = 0, step = 0.1, group = grpExit)
tpPct   = input.float(0.8, "익절 %", minval = 0, step = 0.1, group = grpExit)
maxHold = input.int(24, "최대 보유 봉 수 (0 = 무제한)", minval = 0, group = grpExit)

// ── 박스 / 수축 계산 (현재 봉 제외: [1]) ────────────
boxHigh  = ta.highest(high, boxLen)[1]
boxLow   = ta.lowest(low,  boxLen)[1]
boxRange = boxHigh - boxLow
avgRange = ta.sma(boxRange, avgLen)
squeeze  = boxRange < avgRange * sqRatio

// ── 상위 타임프레임 추세 (lookahead 금지 + 확정봉) ───
htfEma  = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfLen)[1], lookahead = barmerge.lookahead_off)
upTrend = not useHtf or close > htfEma
dnTrend = not useHtf or close < htfEma

// ── 돌파 확인 필터 ──────────────────────────────────
volOk   = not useVol or volume > ta.sma(volume, volLen)[1] * volMult
barRng  = high - low
clsUp   = not useCls or (barRng > 0 and (close - low) / barRng >= clsPos)   // 롱: 종가가 봉 위쪽
clsDn   = not useCls or (barRng > 0 and (high - close) / barRng >= clsPos)  // 숏: 종가가 봉 아래쪽

// ── 신호 ────────────────────────────────────────────
flat        = strategy.position_size == 0
longSignal  = squeeze and close > boxHigh and upTrend and volOk and clsUp and flat and barstate.isconfirmed
shortSignal = squeeze and close < boxLow  and dnTrend and volOk and clsDn and flat and barstate.isconfirmed

// ── 주문 ────────────────────────────────────────────
if longSignal
    strategy.entry("Long", strategy.long)
if shortSignal
    strategy.entry("Short", strategy.short)

if slPct > 0 or tpPct > 0
    strategy.exit("Long Exit",  "Long",
         stop  = slPct > 0 ? strategy.position_avg_price * (1 - slPct / 100) : na,
         limit = tpPct > 0 ? strategy.position_avg_price * (1 + tpPct / 100) : na)
    strategy.exit("Short Exit", "Short",
         stop  = slPct > 0 ? strategy.position_avg_price * (1 + slPct / 100) : na,
         limit = tpPct > 0 ? strategy.position_avg_price * (1 - tpPct / 100) : na)

// 시간 청산: 너무 오래 끌면 정리
if maxHold > 0 and strategy.position_size != 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= maxHold
    strategy.close_all(comment = "time")

// ── 차트 표시 ───────────────────────────────────────
plot(boxHigh, "Box High", color = squeeze ? color.new(color.yellow, 0) : color.new(color.gray, 60), style = plot.style_linebr)
plot(boxLow,  "Box Low",  color = squeeze ? color.new(color.yellow, 0) : color.new(color.gray, 60), style = plot.style_linebr)
plot(htfEma,  "HTF EMA",  color = color.new(color.blue, 40), style = plot.style_stepline)
bgcolor(squeeze ? color.new(color.yellow, 92) : na)
