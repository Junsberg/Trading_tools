//@version=6
// 백테스트용 strategy 버전 (BINANCE:BTCUSDT.P 5분봉 기준)
// 후보 B: VWAP 되돌림 (평균회귀)
//   1) 레짐 필터 : ADX 가 낮을 때만 (추세장에서는 역추세 진입 금지)
//   2) 트리거    : 종가가 VWAP ± k·표준편차 밴드 밖으로 나갔다가 다시 안으로 복귀하는 확정봉
//   3) 청산      : VWAP 터치 시 청산(옵션) / 손절 % / 익절 % / 최대 보유 봉 수
// - 모든 필터는 입력값으로 켜고 끌 수 있음 → tv-api 에서 --set 으로 조합 테스트
strategy("My Scalping Strategy B", shorttitle = "MySS-B", overlay = true,
     initial_capital       = 10000,
     default_qty_type      = strategy.percent_of_equity,
     default_qty_value     = 100,
     commission_type       = strategy.commission.percent,
     commission_value      = 0.04,            // 바이낸스 선물 테이커 수수료
     slippage              = 2,               // 틱 단위
     margin_long           = 0,               // v6 기본값 100 이면 자본 100% 진입 시 손실마다 마진콜 발생
     margin_short          = 0,
     calc_on_every_tick    = false,           // 리페인팅 방지: 봉 확정 시에만 계산
     process_orders_on_close = true)          // 확정봉 종가에 주문 처리

// ── 입력값 ──────────────────────────────────────────
grpBand = "VWAP 밴드"
devLen  = input.int(50,  "표준편차 산출 봉 수", minval = 10, group = grpBand)
bandK   = input.float(2.0, "밴드 배수 k", minval = 0.5, step = 0.1, group = grpBand)
minDist = input.float(0.3, "최소 VWAP 거리 % (밴드가 너무 좁을 때 방지)", minval = 0, step = 0.05, group = grpBand)

grpFlt  = "레짐 필터"
useAdx  = input.bool(true, "ADX 필터 사용", group = grpFlt)
adxLen  = input.int(14, "ADX 기간", minval = 5, group = grpFlt)
adxMax  = input.float(25, "ADX 상한 (이보다 낮을 때만 진입)", minval = 5, step = 1, group = grpFlt)
useRsi  = input.bool(true, "RSI 극단 확인 사용", group = grpFlt)
rsiLen  = input.int(7, "RSI 기간", minval = 2, group = grpFlt)
rsiLow  = input.float(30, "RSI 롱 기준 (이하)", minval = 5, maxval = 50, group = grpFlt)
rsiHigh = input.float(70, "RSI 숏 기준 (이상)", minval = 50, maxval = 95, group = grpFlt)

grpExit = "청산"
useVwapExit = input.bool(true, "VWAP 도달 시 청산", group = grpExit)
slPct   = input.float(0.5, "손절 %", minval = 0, step = 0.1, group = grpExit)
tpPct   = input.float(1.0, "익절 %", minval = 0, step = 0.1, group = grpExit)
maxHold = input.int(36, "최대 보유 봉 수 (0 = 무제한)", minval = 0, group = grpExit)

// ── 계산 (전역에서 호출: 히스토리 일관성) ──────────
vwap    = ta.vwap(hlc3)
dev     = ta.stdev(close - vwap, devLen)
upper   = vwap + bandK * dev
lower   = vwap - bandK * dev
distPct = math.abs(close - vwap) / vwap * 100
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
rsi     = ta.rsi(close, rsiLen)

chop    = not useAdx or adx < adxMax
rsiOkL  = not useRsi or rsi[1] <= rsiLow    // 직전 봉이 과매도
rsiOkS  = not useRsi or rsi[1] >= rsiHigh   // 직전 봉이 과매수
farEnough = distPct[1] >= minDist           // 직전 봉이 VWAP 에서 충분히 멀었음

// ── 신호: 밴드 밖 → 안으로 복귀 ─────────────────────
flat        = strategy.position_size == 0
longSignal  = close[1] < lower[1] and close > lower and chop and rsiOkL and farEnough and flat and barstate.isconfirmed
shortSignal = close[1] > upper[1] and close < upper and chop and rsiOkS and farEnough and flat and barstate.isconfirmed

// ── 주문 ────────────────────────────────────────────
if longSignal
    strategy.entry("Long", strategy.long)
if shortSignal
    strategy.entry("Short", strategy.short)

if slPct > 0 or tpPct > 0
    strategy.exit("Long Exit",  "Long",
         stop  = slPct > 0 ? strategy.position_avg_price * (1 - slPct / 100) : na,
         limit = tpPct > 0 ? strategy.position_avg_price * (1 + tpPct / 100) : na)
    strategy.exit("Short Exit", "Short",
         stop  = slPct > 0 ? strategy.position_avg_price * (1 + slPct / 100) : na,
         limit = tpPct > 0 ? strategy.position_avg_price * (1 - tpPct / 100) : na)

// VWAP 도달 청산 (평균회귀 목표 달성)
if useVwapExit and strategy.position_size > 0 and close >= vwap
    strategy.close("Long", comment = "vwap")
if useVwapExit and strategy.position_size < 0 and close <= vwap
    strategy.close("Short", comment = "vwap")

// 시간 청산
if maxHold > 0 and strategy.position_size != 0 and bar_index - strategy.opentrades.entry_bar_index(0) >= maxHold
    strategy.close_all(comment = "time")

// ── 차트 표시 ───────────────────────────────────────
plot(vwap,  "VWAP",  color = color.new(color.orange, 0))
plot(upper, "Upper", color = color.new(color.red, 50))
plot(lower, "Lower", color = color.new(color.green, 50))
bgcolor(chop ? na : color.new(color.red, 92))
